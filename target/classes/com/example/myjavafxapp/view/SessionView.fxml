<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.myjavafxapp.controller.SessionController"
            prefHeight="500.0" prefWidth="700.0">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <center>
        <TableView fx:id="sessionTable" prefHeight="300.0" prefWidth="500.0">
            <columns>
                <TableColumn fx:id="sessionNumberColumn" prefWidth="180.0" text="Session Number/Year"/>
                <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date"/>
                <TableColumn fx:id="isActiveColumn" prefWidth="80.0" text="Active"/>
            </columns>
            <BorderPane.margin>
                <Insets top="10.0"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10.0" alignment="CENTER_LEFT">
            <BorderPane.margin>
                <Insets top="10.0"/>
            </BorderPane.margin>
            <children>
                <GridPane hgap="10.0" vgap="5.0">
                    <Label text="Session Number/Year:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="sessionNumberField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="datePicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="10.0" alignment="CENTER_LEFT" paddingTop="5.0">
                    <Button fx:id="addButton" text="Add Session" onAction="#handleAddButtonAction"/>
                    <Button fx:id="updateButton" text="Update Session" onAction="#handleUpdateButtonAction"/>
                    <Button fx:id="deleteButton" text="Delete Selected" onAction="#handleDeleteButtonAction"/>
                    <Button fx:id="clearButton" text="Clear Form" onAction="#handleClearButtonAction"/>
                </HBox>
                <HBox spacing="10.0" alignment="CENTER_LEFT" paddingTop="10.0">
                     <Button fx:id="toggleActivationButton" text="Activate" onAction="#handleToggleActivationButtonAction" prefWidth="120.0"/>
                </HBox>
            </children>
        </VBox>
    </bottom>

    <right>
        <VBox fx:id="attendancePane" spacing="10.0" prefWidth="250.0" visible="false" managed="false">
            <padding>
                <Insets left="15.0" top="10.0"/>
            </padding>
            <children>
                <Label fx:id="attendanceSessionLabel" text="Attendance for Session: " style="-fx-font-weight: bold;"/>
                <ListView fx:id="attendanceCouncilorListView" prefHeight="400.0"/>
            </children>
        </VBox>
    </right>
</BorderPane>
